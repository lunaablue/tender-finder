// Wrangler is Cloudflare's command-line tool. This file tells it how to build and run the Worker.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The name of the Worker. It becomes part of its web address.
  "name": "tender-finder",
  // The file where the Worker's code starts.
  "main": "src/index.ts",
  // The date the Worker's runtime rules were set. Keep it as is.
  "compatibility_date": "2025-01-01",
  // Settings the Worker reads at runtime.
  // DAYS_BACK: how many days of notices to fetch (the window starts at midnight UTC that many days ago).
  "vars": {
    "DAYS_BACK": "2"
  },
  // The D1 database (a small SQL database). "DB" is the name the code uses.
  // database_id is a placeholder for local testing. Before deploying, replace it with
  // the real ID from "npx wrangler d1 create tender-finder" (keep the real ID out of public docs).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tender-finder",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Cron triggers run the Worker on a schedule.
  // "0 6 * * *" means every day at 06:00 UTC. This is a placeholder: it does nothing yet.
  "triggers": {
    "crons": ["0 6 * * *"]
  }
}
